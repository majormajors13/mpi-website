---
import { Image } from "astro:assets";
import { lunaArtifacts } from "../../data/luna-evidence";
import { lunaHistory } from "../../data/luna-history";
import EvidenceViewer from "../artifacts/EvidenceViewer.astro";
const artifacts = lunaArtifacts.filter((artifact) => artifact.publicSafe);
---

<section
  id="timeline"
  class="development"
  aria-labelledby="development-title"
  data-development-timeline
>
  <div class="container">
    <header class="development__heading">
      <p>Development timeline // Version progression</p><h2
        id="development-title"
      >
        How LUNA got here
      </h2><p>
        Scan the version eras, then open any chapter to inspect the
        capabilities, problems, and engineering decisions that shaped it.
      </p>
    </header>
    <ol class="timeline-list">
      {
        lunaHistory.map((record, index) => {
          const recordArtifacts = record.evidenceIds
            .map((id) => artifacts.find((artifact) => artifact.id === id))
            .filter(Boolean);
          return (
            <li class="timeline-chapter">
              <span class="timeline-chapter__node" aria-hidden="true" />
              <button
                class="timeline-chapter__control"
                type="button"
                aria-expanded="false"
                aria-controls={`version-panel-${record.id}`}
                data-version-toggle={record.id}
              >
                <span class="timeline-chapter__index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="timeline-chapter__identity">
                  <>
                    <strong>{record.label}</strong>
                    <b>{record.eraTitle}</b>
                    <span>{record.status}</span>
                  </>
                </span>
                <span class="timeline-chapter__action" aria-hidden="true">
                  Open chapter
                </span>
              </button>
              <article
                class="development-record"
                id={`version-panel-${record.id}`}
                data-version-panel={record.id}
                hidden
              >
                <header>
                  <>
                    <p>
                      {record.label} // {record.status}
                    </p>
                    <h3>{record.eraTitle}</h3>
                  </>
                </header>
                <dl class="development-record__story">
                  <div>
                    <>
                      <dt>Result</dt>
                      <dd>{record.result}</dd>
                    </>
                  </div>
                  {record.learned && (
                    <div>
                      <dt>What I learned</dt>
                      <dd>{record.learned}</dd>
                    </div>
                  )}
                </dl>
                <div class="development-record__columns">
                  <>
                    <section aria-labelledby={`${record.id}-issues`}>
                      <>
                        <h4 id={`${record.id}-issues`}>Development issues</h4>
                        <ul>
                          {record.developmentIssues.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </section>
                    <section aria-labelledby={`${record.id}-resolutions`}>
                      <>
                        <h4 id={`${record.id}-resolutions`}>
                          How they were resolved
                        </h4>
                        <ul>
                          {record.resolutions.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </section>
                  </>
                </div>
                <section
                  class="development-record__scope"
                  aria-labelledby={`${record.id}-scope`}
                >
                  <>
                    <h4 id={`${record.id}-scope`}>Major capabilities</h4>
                    <ul>
                      {record.deliveredScope.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                </section>
                {record.validationSnapshots && (
                  <section
                    class="validation-snapshots"
                    aria-labelledby={`${record.id}-validation`}
                  >
                    <h4 id={`${record.id}-validation`}>
                      Validation progression
                    </h4>
                    <ol>
                      {record.validationSnapshots.map((value) => (
                        <li>{value}</li>
                      ))}
                    </ol>
                    <p>
                      Recorded full-suite snapshots during v2 development. They
                      show validation growth, not a final authoritative test
                      total.
                    </p>
                  </section>
                )}
                {recordArtifacts.length > 0 && (
                  <section
                    class="development-record__evidence"
                    aria-labelledby={`${record.id}-evidence`}
                  >
                    <h4 id={`${record.id}-evidence`}>Development artifacts</h4>
                    {recordArtifacts.map(
                      (artifact) =>
                        artifact && (
                          <button
                            type="button"
                            data-evidence-open={artifact.id}
                            aria-haspopup="dialog"
                          >
                            <span class="development-record__image">
                              <Image
                                src={artifact.image!}
                                alt={artifact.alt ?? ""}
                                widths={[480, 800, 1200]}
                                sizes="(max-width: 52rem) calc(100vw - 5rem), 32rem"
                                format="webp"
                                quality={80}
                              />
                            </span>
                            <span>
                              <small>
                                {artifact.state} // {artifact.artifactType}
                              </small>
                              <strong>{artifact.title}</strong>
                              <span>{artifact.description}</span>
                              <em>Inspect artifact ↗</em>
                            </span>
                          </button>
                        ),
                    )}
                  </section>
                )}
              </article>
            </li>
          );
        })
      }
    </ol>
    <p class="development__metric-note">
      Code and test counts indicate project scale and validation growth, not
      software quality by themselves. Unsupported historical counters are
      intentionally omitted.
    </p>
  </div>
</section>
<EvidenceViewer artifacts={artifacts} />
<style>
  .development {
    padding-block: clamp(var(--space-8), 10vw, 8rem);
    border-block-end: 1px solid var(--color-border);
    background:
      linear-gradient(rgb(172 124 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(172 124 255 / 3%) 1px, transparent 1px),
      var(--color-surface);
    background-size: 4rem 4rem;
  }
  .development__heading {
    max-width: 50rem;
  }
  .development__heading > p:first-child,
  .development-record header p,
  dt,
  h4,
  .timeline-chapter__index,
  .timeline-chapter__identity span,
  small {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .development__heading h2 {
    margin-block-start: var(--space-3);
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
  }
  .development__heading > p:last-child,
  .development__metric-note {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
  }
  .timeline-list {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }
  .timeline-list::before {
    position: absolute;
    inset: 0 auto 0 0.7rem;
    width: 1px;
    background: linear-gradient(
      var(--color-accent-highlight),
      rgb(115 71 216 / 20%)
    );
    content: "";
  }
  .timeline-chapter {
    position: relative;
    padding-inline-start: 2.5rem;
  }
  .timeline-chapter__node {
    position: absolute;
    z-index: 1;
    inset: 1.65rem auto auto 0.35rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--color-accent-highlight);
    border-radius: 50%;
    background: var(--color-surface);
    transition:
      background-color 240ms ease-out,
      box-shadow 240ms ease-out;
  }
  .timeline-chapter:has(.timeline-chapter__control[aria-expanded="true"])
    .timeline-chapter__node {
    background: var(--color-accent-highlight);
    box-shadow: 0 0 1rem rgb(172 124 255 / 60%);
  }
  .timeline-chapter__control {
    display: grid;
    width: 100%;
    min-height: 5rem;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-canvas);
    color: var(--color-text-primary);
    cursor: pointer;
    text-align: start;
    transition:
      border-color 240ms ease-out,
      background-color 240ms ease-out;
  }
  .timeline-chapter__control:hover,
  .timeline-chapter__control:focus-visible,
  .timeline-chapter__control[aria-expanded="true"] {
    border-color: var(--color-accent-highlight);
    background: rgb(115 71 216 / 10%);
  }
  .timeline-chapter__identity {
    display: grid;
    gap: var(--space-1);
  }
  .timeline-chapter__identity strong {
    font-size: clamp(1.15rem, 3vw, 1.5rem);
  }
  .timeline-chapter__identity b {
    font-size: 0.8125rem;
    text-transform: uppercase;
  }
  .timeline-chapter__identity span {
    color: var(--color-text-muted);
  }
  .timeline-chapter__action {
    display: none;
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .timeline-chapter__control[aria-expanded="true"] .timeline-chapter__action {
    font-size: 0;
  }
  .timeline-chapter__control[aria-expanded="true"]
    .timeline-chapter__action::after {
    font-size: 0.6875rem;
    content: "Close chapter";
  }
  .development-record {
    margin-block-start: var(--space-3);
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border: 1px solid var(--color-accent-highlight);
    border-radius: var(--radius-large);
    background: var(--color-canvas);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 25%);
  }
  .development-record header h3 {
    margin-block-start: var(--space-2);
    font-size: clamp(1.75rem, 5vw, 3rem);
  }
  .development-record__story {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
  }
  .development-record__story > div,
  .development-record__columns > section,
  .validation-snapshots,
  .development-record__evidence {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }
  dd {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }
  .development-record__columns {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
  }
  .development-record ul {
    margin: var(--space-3) 0 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-muted);
  }
  .development-record__scope {
    margin-block-start: var(--space-6);
  }
  .development-record__scope ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .development-record__scope li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .validation-snapshots,
  .development-record__evidence {
    margin-block-start: var(--space-6);
  }
  .validation-snapshots ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .validation-snapshots li {
    padding: var(--space-4);
    border: 1px solid var(--color-accent);
    font-weight: 700;
  }
  .validation-snapshots p {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .development-record__evidence > button {
    display: grid;
    width: 100%;
    margin-block-start: var(--space-4);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
    text-align: start;
  }
  .development-record__evidence > button > span:last-child {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .development-record__evidence strong {
    font-size: 1.25rem;
  }
  .development-record__evidence em {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-style: normal;
    text-transform: uppercase;
  }
  .development-record__image img {
    width: 100%;
    height: auto;
  }
  @media (min-width: 40rem) {
    .timeline-chapter__control {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .timeline-chapter__action {
      display: block;
    }
    .development-record__story,
    .development-record__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .timeline-list::before {
      inset-inline-start: 1rem;
    }
    .timeline-chapter {
      padding-inline-start: 3.5rem;
    }
    .timeline-chapter__node {
      inset-inline-start: 0.65rem;
    }
    .development-record__evidence > button {
      grid-template-columns: minmax(18rem, 1fr) minmax(16rem, 0.75fr);
      align-items: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-chapter__node,
    .timeline-chapter__control {
      transition: none;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-development-timeline]")
    .forEach((root) => {
      root
        .querySelectorAll<HTMLButtonElement>("[data-version-toggle]")
        .forEach((control) => {
          control.addEventListener("click", () => {
            const expanded = control.getAttribute("aria-expanded") === "true";
            const panel = root.querySelector<HTMLElement>(
              `[data-version-panel="${control.dataset.versionToggle}"]`,
            );
            control.setAttribute("aria-expanded", String(!expanded));
            if (panel) panel.hidden = expanded;
          });
        });
    });
</script>
