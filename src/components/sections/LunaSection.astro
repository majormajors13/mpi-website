---
import { Image } from "astro:assets";
import lunaLogo from "../../assets/logos/luna-logo.png";
import StatusLabel from "../StatusLabel.astro";
---

<section id="luna" class="luna" aria-labelledby="luna-title">
  <div class="luna__inner container">
    <div class="luna__introduction">
      <StatusLabel label="Project // LUNA" />

      <p class="luna__name">Luminary Unit of Nuisance Abatement</p>

      <h2 id="luna-title">LUNA</h2>

      <p class="luna__lead">
        LUNA is an AI system that keeps the useful context instead of forgetting
        it after one conversation.
      </p>

      <p class="luna__description">
        It follows ongoing projects and helps with planning, research,
        reasoning, and the decisions that come with them. This is only the
        public surface.
      </p>

      <ul class="luna__statuses" aria-label="LUNA project status">
        <li>Status // Active development</li>
        <li>Source // Proprietary</li>
        <li>Team // Independent</li>
      </ul>

      <a class="luna__cta" href="/luna">Meet LUNA</a>
    </div>

    <div class="luna__visual">
      <div class="luna__logo-wrap">
        <Image
          class="luna__logo"
          src={lunaLogo}
          alt=""
          widths={[280, 420, 640, 800]}
          sizes="(max-width: 58rem) min(78vw, 24rem), min(30vw, 24rem)"
          format="webp"
          quality={85}
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .luna {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-block: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 18% 72%,
        rgb(188 64 207 / 7%) 0 2px,
        transparent 3px
      ),
      linear-gradient(
        90deg,
        transparent 18%,
        rgb(172 124 255 / 4%) 18% 18.1%,
        transparent 18.1% 76%,
        rgb(188 64 207 / 3%) 76% 76.1%,
        transparent 76.1%
      ),
      linear-gradient(
        35deg,
        transparent 48%,
        rgb(172 124 255 / 3%) 48% 48.2%,
        transparent 48.2%
      ),
      radial-gradient(
        circle at 82% 22%,
        rgb(172 124 255 / 10%),
        transparent 28rem
      ),
      var(--color-surface);
    background-size:
      22rem 18rem,
      100% 100%,
      28rem 28rem,
      auto,
      auto;
  }

  .luna::before,
  .luna::after {
    position: absolute;
    z-index: -1;
    border: 1px solid rgb(172 124 255 / 8%);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .luna::before {
    inset-block-start: 5rem;
    inset-inline-end: -12rem;
    width: 30rem;
    height: 30rem;
  }

  .luna::after {
    inset-block-start: 10rem;
    inset-inline-end: -7rem;
    width: 20rem;
    height: 20rem;
  }

  .luna__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(var(--space-8), 10vw, 8rem);
  }

  .luna__introduction {
    max-width: 42rem;
  }

  .luna__name {
    margin-block-start: var(--space-5);
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    margin-block-start: var(--space-2);
    font-size: clamp(4rem, 14vw, 8rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .luna__lead {
    max-width: 38rem;
    margin-block-start: var(--space-5);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .luna__description {
    max-width: 40rem;
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
  }

  .luna__statuses {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .luna__statuses li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgb(8 7 11 / 45%);
    color: var(--color-text-muted);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .luna__details {
    position: relative;
    align-self: start;
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: rgb(8 7 11 / 58%);
    box-shadow: var(--shadow-surface), var(--shadow-accent);
  }

  .luna__visual {
    display: grid;
    gap: var(--space-6);
    align-self: start;
  }

  .luna__logo-wrap {
    width: min(78vw, 24rem);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 1.5rem;
  }

  .luna__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    margin-block-start: var(--space-6);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-accent-highlight);
    border-radius: 999px;
    color: var(--color-text-primary);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .luna__cta:hover {
    background: rgb(172 124 255 / 10%);
  }

  .luna__logo {
    width: 100%;
    height: auto;
  }

  @media (min-width: 58rem) {
    .luna__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
      align-items: center;
      gap: clamp(var(--space-7), 8vw, 7rem);
    }
  }

  @media (max-width: 32rem) {
    .luna {
      background-size:
        18rem 16rem,
        100% 100%,
        34rem 34rem,
        auto,
        auto;
    }
  }
</style>
