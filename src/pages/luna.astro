---
import { Image } from "astro:assets";
import lunaLogo from "../assets/logos/luna-logo.png";
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "A placeholder for the upcoming LUNA project showcase from Major Problem Industries.";
---

<BaseLayout title="LUNA" description={description}>
  <main id="main-content" class="luna-page" tabindex="-1">
    <div class="luna-page__glow" aria-hidden="true"></div>
    <div class="luna-page__content">
      <div class="luna-page__logo-wrap">
        <Image
          class="luna-page__logo"
          src={lunaLogo}
          alt=""
          widths={[280, 420, 640, 800]}
          sizes="min(76vw, 22rem)"
          format="webp"
          quality={85}
        />
      </div>

      <div class="luna-page__copy">
        <p class="luna-page__status">Project // LUNA</p>
        <h1>LUNA</h1>
        <p class="luna-page__name">Luminary Unit of Nuisance Abatement</p>
        <p class="luna-page__message">
          The full LUNA project showcase is being prepared.
        </p>
        <a class="luna-page__home" href="/">
          Return to Major Problem Industries
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .luna-page {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100vh;
    overflow: hidden;
    place-items: center;
    padding: clamp(var(--space-7), 10vw, 8rem) var(--content-gutter);
    background:
      radial-gradient(
        circle at 50% 28%,
        rgb(172 124 255 / 12%),
        transparent 28rem
      ),
      var(--color-canvas);
  }

  .luna-page__glow {
    position: absolute;
    z-index: -1;
    width: min(75vw, 42rem);
    aspect-ratio: 1;
    border: 1px solid rgb(172 124 255 / 10%);
    border-radius: 50%;
    box-shadow: 0 0 8rem rgb(115 71 216 / 10%);
  }

  .luna-page__content {
    display: grid;
    width: min(100%, 58rem);
    align-items: center;
    gap: clamp(var(--space-6), 7vw, var(--space-8));
    text-align: center;
  }

  .luna-page__logo-wrap {
    width: min(76vw, 22rem);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-surface), var(--shadow-accent);
  }

  .luna-page__logo {
    width: 100%;
    height: auto;
  }

  .luna-page__status,
  .luna-page__name {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin-block-start: var(--space-3);
    font-size: clamp(4rem, 18vw, 8rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .luna-page__name {
    margin-block-start: var(--space-4);
  }

  .luna-page__message {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: clamp(1.125rem, 3vw, 1.375rem);
  }

  .luna-page__home {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    margin-block-start: var(--space-6);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-accent-highlight);
    border-radius: 999px;
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .luna-page__home:hover {
    background: rgb(172 124 255 / 10%);
  }

  @media (min-width: 48rem) {
    .luna-page__content {
      grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1fr);
      text-align: start;
    }
  }
</style>
