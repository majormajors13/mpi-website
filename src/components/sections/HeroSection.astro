---
import { Image } from "astro:assets";
import mpiLogo from "../../assets/logos/mpi logo.jpg";
import StatusLabel from "../StatusLabel.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__content">
      <StatusLabel label="System status // Initializing" />
      <p class="hero__eyebrow">Major Problem Industries</p>
      <h1 id="hero-title">
        Software, AI, systems—and whatever needs building next.
      </h1>
      <p class="hero__summary">
        An independent workshop for technical projects with real machinery
        behind the ideas. The operation is evolving. The work is already
        underway.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#identity">What is MPI?</a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__logo-frame">
        <Image
          class="hero__logo"
          src={mpiLogo}
          alt="Major Problem Industries logo: a purple flaming skeleton working on circuitry above the company name"
          widths={[320, 480, 600]}
          sizes="(max-width: 60rem) min(82vw, 30rem), min(42vw, 37.5rem)"
          format="webp"
          quality={85}
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-block-end: 1px solid var(--color-border);
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    inset-block-start: 18%;
    inset-inline-end: -12rem;
    width: 30rem;
    height: 30rem;
    border-radius: 50%;
    background: rgb(115 71 216 / 12%);
    filter: blur(7rem);
    content: "";
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding-block: clamp(var(--space-7), 9vw, 7rem);
  }

  .hero__content {
    max-width: 42rem;
  }

  .hero__eyebrow {
    margin-block-start: var(--space-5);
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin-block-start: var(--space-3);
    font-size: clamp(2.5rem, 8vw, 5.75rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero__summary {
    max-width: 38rem;
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-medium);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) ease-out,
      border-color var(--motion-fast) ease-out,
      color var(--motion-fast) ease-out,
      box-shadow var(--motion-fast) ease-out;
  }

  .button--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: var(--shadow-accent);
    color: var(--color-text-primary);
  }

  .button--primary:hover {
    border-color: var(--color-accent-highlight);
    background: var(--color-accent-highlight);
    color: var(--color-canvas);
  }

  .hero__visual {
    width: min(100%, 37.5rem);
    margin-inline: auto;
  }

  .hero__logo-frame {
    position: relative;
    padding: clamp(var(--space-2), 2vw, var(--space-4));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface), var(--shadow-accent);
  }

  .hero__logo-frame::before,
  .hero__logo-frame::after {
    position: absolute;
    width: 3.5rem;
    height: 3.5rem;
    border-color: var(--color-accent-highlight);
    content: "";
    pointer-events: none;
  }

  .hero__logo-frame::before {
    inset-block-start: -1px;
    inset-inline-start: -1px;
    border-block-start: 1px solid;
    border-inline-start: 1px solid;
    border-start-start-radius: var(--radius-large);
  }

  .hero__logo-frame::after {
    inset-block-end: -1px;
    inset-inline-end: -1px;
    border-block-end: 1px solid;
    border-inline-end: 1px solid;
    border-end-end-radius: var(--radius-large);
  }

  .hero__logo {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-large) - var(--space-2));
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
