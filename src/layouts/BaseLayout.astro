---
import "../styles/global.css";
import favicon from "../assets/logos/favicon.png";

interface Props {
  title?: string;
  description?: string;
  canonical?: URL | string;
}

const siteName = "Major Problem Industries";
const {
  title = siteName,
  description = "A personal technical umbrella for software, AI, systems, and experimental work.",
  canonical,
} = Astro.props;

const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalUrl = canonical
  ? canonical instanceof URL
    ? canonical
    : new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/social-preview.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08070b" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={favicon.src} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Major Problem Industries — software, AI, and systems"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
