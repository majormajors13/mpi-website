---
import { Image } from "astro:assets";
import mpiLogo from "../assets/logos/mpi logo.jpg";
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-brand" href="/" aria-label="Major Problem Industries, home">
      <Image
        class="site-brand__logo"
        src={mpiLogo}
        alt=""
        width={52}
        height={52}
        format="webp"
        quality={80}
      />
      <span class="site-brand__name">Major Problem Industries</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <a class="nav-link" href="#identity">What is MPI?</a>
      <a class="nav-link" href="#luna">LUNA</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    inset-block-start: 0;
    border-block-end: 1px solid var(--color-border);
    background: rgb(8 7 11 / 88%);
    backdrop-filter: blur(0.75rem);
  }

  .site-header__inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .site-brand,
  .nav-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1);
  }

  .site-brand {
    min-width: 0;
    gap: var(--space-3);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .site-brand__logo {
    width: 3.25rem;
    height: 3.25rem;
    flex: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
  }

  .site-brand__name {
    font-size: clamp(0.875rem, 2vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .nav-link {
    padding-inline: var(--space-3);
    border-radius: var(--radius-small);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-text-primary);
  }

  @media (max-width: 27rem) {
    .site-brand__name {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .site-brand__logo {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
