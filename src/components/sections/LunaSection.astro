---
import { Image } from "astro:assets";
import lunaLogo from "../../assets/logos/luna logo.png";
import StatusLabel from "../StatusLabel.astro";
---

<section id="luna" class="luna" aria-labelledby="luna-title">
  <div class="luna__inner container">
    <div class="luna__introduction">
      <StatusLabel label="Project // LUNA" />
      <p class="luna__name">Luminary Unit of Nuisance Abatement</p>
      <h2 id="luna-title">LUNA</h2>
      <p class="luna__lead">
        An AI system being built to become a long-term working partner—not
        another disposable chat window.
      </p>
      <p class="luna__description">
        LUNA is designed to remember and organize useful context, carry work
        across projects, and help with planning, research, and reasoning while
        preserving a clear history of decisions and actions. Over time,
        specialized capabilities can work together under deliberate user
        control.
      </p>

      <ul class="luna__statuses" aria-label="LUNA project status">
        <li>Status // Active development</li>
        <li>Source // Proprietary</li>
      </ul>
    </div>

    <div class="luna__visual">
      <div class="luna__logo-wrap">
        <Image
          class="luna__logo"
          src={lunaLogo}
          alt=""
          widths={[280, 420, 640, 800]}
          sizes="(max-width: 58rem) min(78vw, 24rem), min(30vw, 24rem)"
          format="webp"
          quality={85}
          loading="lazy"
        />
      </div>

      <div class="luna__details">
        <p class="luna__details-label">System direction</p>
        <dl class="luna__features">
          <div>
            <dt>Continuity</dt>
            <dd>
              Useful knowledge and project context designed to persist over
              time.
            </dd>
          </div>
          <div>
            <dt>Clear history</dt>
            <dd>
              Decisions and controlled actions kept understandable and
              traceable.
            </dd>
          </div>
          <div>
            <dt>Specialized help</dt>
            <dd>
              Planning, research, and reasoning that can grow into coordinated
              capabilities.
            </dd>
          </div>
        </dl>
        <p class="luna__solo-note">
          Built independently as the flagship project of Major Problem
          Industries.
        </p>
        <p class="luna__next">More on LUNA soon</p>
      </div>
    </div>
  </div>
</section>

<style>
  .luna {
    position: relative;
    isolation: isolate;
    scroll-margin-top: 6rem;
    overflow: clip;
    border-block: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 82% 22%,
        rgb(172 124 255 / 10%),
        transparent 28rem
      ),
      var(--color-surface);
  }

  .luna::before,
  .luna::after {
    position: absolute;
    z-index: -1;
    border: 1px solid rgb(172 124 255 / 8%);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .luna::before {
    inset-block-start: 5rem;
    inset-inline-end: -12rem;
    width: 30rem;
    height: 30rem;
  }

  .luna::after {
    inset-block-start: 10rem;
    inset-inline-end: -7rem;
    width: 20rem;
    height: 20rem;
  }

  .luna__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(var(--space-8), 10vw, 8rem);
  }

  .luna__introduction {
    max-width: 42rem;
  }

  .luna__name {
    margin-block-start: var(--space-5);
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    margin-block-start: var(--space-2);
    font-size: clamp(4rem, 14vw, 8rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .luna__lead {
    max-width: 38rem;
    margin-block-start: var(--space-5);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 650;
    line-height: 1.3;
  }

  .luna__description {
    max-width: 40rem;
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
  }

  .luna__statuses {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .luna__statuses li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgb(8 7 11 / 45%);
    color: var(--color-text-muted);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .luna__details {
    position: relative;
    align-self: start;
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: rgb(8 7 11 / 58%);
    box-shadow: var(--shadow-surface), var(--shadow-accent);
  }

  .luna__visual {
    display: grid;
    gap: var(--space-6);
    align-self: start;
  }

  .luna__logo-wrap {
    width: min(78vw, 24rem);
    margin-inline: auto;
  }

  .luna__logo {
    width: 100%;
    height: auto;
  }

  .luna__details::before {
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: var(--space-6);
    width: 5rem;
    height: 1px;
    background: var(--color-accent-highlight);
    box-shadow: var(--shadow-accent);
    content: "";
    pointer-events: none;
  }

  .luna__details-label,
  .luna__next {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .luna__features {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
  }

  .luna__features div {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  .luna__features dt {
    font-weight: 750;
  }

  .luna__features dd {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }

  .luna__solo-note {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .luna__next {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  @media (min-width: 58rem) {
    .luna__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
      align-items: center;
      gap: clamp(var(--space-7), 8vw, 7rem);
    }
  }
</style>
