---
import { lunaHistory } from "../../data/luna-history";
const exactNumber = new Intl.NumberFormat("en-US");
const compactNumber = (value: number) =>
  value < 1000 ? String(value) : `${(value / 1000).toFixed(1)}K`;
const pytestDefinition =
  "Collected pytest cases at the selected historical repository checkpoint.";
---

<section
  id="timeline"
  class="development"
  aria-labelledby="development-title"
  data-development-timeline
>
  <div class="container">
    <header class="development__heading">
      <p>Development timeline // Version progression</p><h2
        id="development-title"
      >
        How LUNA got here
      </h2><p>
        Scan the version eras, then open any chapter to inspect the
        capabilities, problems, and engineering decisions that shaped it.
      </p>
    </header>
    <ol class="timeline-list">
      {
        lunaHistory.map((record, index) => {
          return (
            <li class="timeline-chapter">
              <span class="timeline-chapter__node" aria-hidden="true" />
              <button
                class="timeline-chapter__control"
                type="button"
                aria-expanded="false"
                aria-controls={`version-panel-${record.id}`}
                data-version-toggle={record.id}
              >
                <span class="timeline-chapter__index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="timeline-chapter__identity">
                  <>
                    <strong>{record.label}</strong>
                    <b>{record.eraTitle}</b>
                    <span>{record.status}</span>
                  </>
                </span>
                <span
                  class="timeline-chapter__metrics"
                  aria-label="Engineering snapshot"
                >
                  <span>
                    <>
                      <strong>
                        {compactNumber(record.metrics.productionLoc)}
                      </strong>
                      <small>Prod LOC</small>
                    </>
                  </span>
                  <span>
                    <>
                      <strong>{compactNumber(record.metrics.testLoc)}</strong>
                      <small>Test LOC</small>
                    </>
                  </span>
                  <span>
                    <strong>
                      {record.metrics.pytestCollected === null
                        ? "—"
                        : exactNumber.format(record.metrics.pytestCollected)}
                    </strong>
                    <small title={pytestDefinition}>Pytest</small>
                  </span>
                </span>
                <span class="timeline-chapter__action" aria-hidden="true">
                  Open chapter
                </span>
              </button>
              <article
                class="development-record"
                id={`version-panel-${record.id}`}
                data-version-panel={record.id}
                hidden
              >
                <header>
                  <>
                    <p>
                      {record.label} // {record.status}
                    </p>
                    <h3>{record.eraTitle}</h3>
                  </>
                </header>
                <dl class="development-record__story">
                  <div>
                    <dt>Initial goal</dt>
                    <dd>{record.problem}</dd>
                  </div>
                  <div>
                    <dt>How it evolved</dt>
                    <dd>{record.change}</dd>
                  </div>
                  <div>
                    <>
                      <dt>Result</dt>
                      <dd>{record.result}</dd>
                    </>
                  </div>
                  {record.learned && (
                    <div>
                      <dt>What I learned</dt>
                      <dd>{record.learned}</dd>
                    </div>
                  )}
                </dl>
                <div class="development-record__columns">
                  <>
                    <section aria-labelledby={`${record.id}-issues`}>
                      <>
                        <h4 id={`${record.id}-issues`}>
                          Key development issues
                        </h4>
                        <ul>
                          {record.developmentIssues.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </section>
                    <section aria-labelledby={`${record.id}-resolutions`}>
                      <>
                        <h4 id={`${record.id}-resolutions`}>Resolution</h4>
                        <ul>
                          {record.resolutions.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </section>
                  </>
                </div>
                <section
                  class="development-record__scope"
                  aria-labelledby={`${record.id}-scope`}
                >
                  <>
                    <h4 id={`${record.id}-scope`}>What this era added</h4>
                    <ul>
                      {record.deliveredScope.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                </section>
                <section
                  class="record-metrics"
                  aria-labelledby={`${record.id}-metrics`}
                >
                  <h4 id={`${record.id}-metrics`}>Engineering snapshot</h4>
                  <dl>
                    <div>
                      <>
                        <dt>Prod LOC</dt>
                        <dd>
                          {exactNumber.format(record.metrics.productionLoc)}
                        </dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>Test LOC</dt>
                        <dd>{exactNumber.format(record.metrics.testLoc)}</dd>
                      </>
                    </div>
                    <div>
                      <dt title={pytestDefinition}>Pytest</dt>
                      <dd>
                        {record.metrics.pytestCollected === null
                          ? "Unavailable"
                          : exactNumber.format(record.metrics.pytestCollected)}
                      </dd>
                    </div>
                  </dl>
                  {record.checkpointVersion && (
                    <p>
                      Committed source version:{" "}
                      <strong>{record.checkpointVersion}</strong>
                    </p>
                  )}
                  {record.metricsNote && <p>{record.metricsNote}</p>}
                </section>
              </article>
            </li>
          );
        })
      }
    </ol>
    <p class="development__metric-note">
      Code and test counts show project scale and validation growth; they are
      not quality scores.
    </p>
  </div>
</section>
<style>
  .development {
    padding-block: clamp(var(--space-8), 10vw, 8rem);
    border-block-end: 1px solid var(--color-border);
    background:
      linear-gradient(rgb(172 124 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(172 124 255 / 3%) 1px, transparent 1px),
      var(--color-surface);
    background-size: 4rem 4rem;
  }
  .development__heading {
    max-width: 50rem;
  }
  .development__heading > p:first-child,
  .development-record header p,
  dt,
  h4,
  .timeline-chapter__index,
  .timeline-chapter__identity span,
  small {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .development__heading h2 {
    margin-block-start: var(--space-3);
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
  }
  .development__heading > p:last-child,
  .development__metric-note {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
  }
  .timeline-list {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }
  .timeline-list::before {
    position: absolute;
    inset: 0 auto 0 0.7rem;
    width: 1px;
    background: linear-gradient(
      var(--color-accent-highlight),
      rgb(115 71 216 / 20%)
    );
    content: "";
  }
  .timeline-chapter {
    position: relative;
    padding-inline-start: 2.5rem;
  }
  .timeline-chapter__node {
    position: absolute;
    z-index: 1;
    inset: 1.65rem auto auto 0.35rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--color-accent-highlight);
    border-radius: 50%;
    background: var(--color-surface);
    transition:
      background-color 240ms ease-out,
      box-shadow 240ms ease-out;
  }
  .timeline-chapter:has(.timeline-chapter__control[aria-expanded="true"])
    .timeline-chapter__node {
    background: var(--color-accent-highlight);
    box-shadow: 0 0 1rem rgb(172 124 255 / 60%);
  }
  .timeline-chapter__control {
    display: grid;
    width: 100%;
    min-height: 5rem;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-canvas);
    color: var(--color-text-primary);
    cursor: pointer;
    text-align: start;
    transition:
      border-color 240ms ease-out,
      background-color 240ms ease-out;
  }
  .timeline-chapter__control:hover,
  .timeline-chapter__control:focus-visible,
  .timeline-chapter__control[aria-expanded="true"] {
    border-color: var(--color-accent-highlight);
    background: rgb(115 71 216 / 10%);
  }
  .timeline-chapter__identity {
    display: grid;
    gap: var(--space-1);
  }
  .timeline-chapter__metrics {
    display: grid;
    grid-column: 2;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: 22rem;
  }
  .timeline-chapter__metrics > span {
    display: grid;
    gap: 0.15rem;
  }
  .timeline-chapter__metrics strong {
    font-family: var(--font-technical);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .timeline-chapter__metrics small {
    color: var(--color-text-muted);
    font-size: 0.5625rem;
  }
  .timeline-chapter__identity strong {
    font-size: clamp(1.15rem, 3vw, 1.5rem);
  }
  .timeline-chapter__identity b {
    font-size: 0.8125rem;
    text-transform: uppercase;
  }
  .timeline-chapter__identity span {
    color: var(--color-text-muted);
  }
  .timeline-chapter__action {
    display: none;
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .timeline-chapter__control[aria-expanded="true"] .timeline-chapter__action {
    font-size: 0;
  }
  .timeline-chapter__control[aria-expanded="true"]
    .timeline-chapter__action::after {
    font-size: 0.6875rem;
    content: "Close chapter";
  }
  .development-record {
    margin-block-start: var(--space-3);
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border: 1px solid var(--color-accent-highlight);
    border-radius: var(--radius-large);
    background: var(--color-canvas);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 25%);
  }
  .development-record header h3 {
    margin-block-start: var(--space-2);
    font-size: clamp(1.75rem, 5vw, 3rem);
  }
  .development-record__story {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
  }
  .development-record__story > div,
  .development-record__columns > section,
  .record-metrics {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }
  dd {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }
  .development-record__columns {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
  }
  .development-record ul {
    margin: var(--space-3) 0 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-muted);
  }
  .development-record__scope {
    margin-block-start: var(--space-6);
  }
  .development-record__scope ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .development-record__scope li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
  }
  .record-metrics {
    margin-block-start: var(--space-6);
  }
  .record-metrics > dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }
  .record-metrics > dl > div {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
  }
  .record-metrics dd {
    color: var(--color-text-primary);
    font-family: var(--font-technical);
    font-size: clamp(1rem, 4vw, 1.35rem);
    font-weight: 700;
    white-space: nowrap;
  }
  .record-metrics p {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  @media (min-width: 40rem) {
    .timeline-chapter__control {
      grid-template-columns: auto minmax(10rem, 1fr) minmax(17rem, 0.8fr) auto;
    }
    .timeline-chapter__metrics {
      grid-column: auto;
    }
    .timeline-chapter__action {
      display: block;
    }
    .development-record__story,
    .development-record__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .timeline-list::before {
      inset-inline-start: 1rem;
    }
    .timeline-chapter {
      padding-inline-start: 3.5rem;
    }
    .timeline-chapter__node {
      inset-inline-start: 0.65rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-chapter__node,
    .timeline-chapter__control {
      transition: none;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-development-timeline]")
    .forEach((root) => {
      root
        .querySelectorAll<HTMLButtonElement>("[data-version-toggle]")
        .forEach((control) => {
          control.addEventListener("click", () => {
            const expanded = control.getAttribute("aria-expanded") === "true";
            const panel = root.querySelector<HTMLElement>(
              `[data-version-panel="${control.dataset.versionToggle}"]`,
            );
            control.setAttribute("aria-expanded", String(!expanded));
            if (panel) panel.hidden = expanded;
          });
        });
    });
</script>
