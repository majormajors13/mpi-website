---
import StatusLabel from "../StatusLabel.astro";
---

<section id="build-log" class="build-log" aria-labelledby="build-log-title">
  <div class="build-log__inner container">
    <div class="build-log__readout" aria-hidden="true">
      <span>LOG INDEX // 000</span>
      <span>ENTRIES // PENDING</span>
    </div>

    <div class="build-log__content">
      <StatusLabel label="Build log // Initializing" />
      <h2 id="build-log-title">The decisions behind the work.</h2>
      <p>
        Future build notes will document what is being built, why choices were
        made, what failed, and what changed. No manufactured launch stories—just
        useful records once there is something worth publishing.
      </p>
      <p class="build-log__state">First entry // Not yet filed</p>
    </div>
  </div>
</section>

<style>
  .build-log {
    padding-block: clamp(var(--space-8), 10vw, 8rem);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .build-log__inner {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(var(--space-5), 5vw, var(--space-7));
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-canvas);
    box-shadow: var(--shadow-surface);
  }

  .build-log__inner::before {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--space-6);
    width: 5rem;
    height: 1px;
    background: var(--color-accent-highlight);
    box-shadow: var(--shadow-accent);
    content: "";
    pointer-events: none;
  }

  .build-log__readout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-content: start;
    color: var(--color-text-muted);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
  }

  .build-log__content {
    max-width: 46rem;
  }

  h2 {
    margin-block-start: var(--space-5);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .build-log__content > p:not(.build-log__state) {
    max-width: 40rem;
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
  }

  .build-log__state {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 52rem) {
    .build-log__inner {
      grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr);
      gap: var(--space-7);
    }

    .build-log__readout {
      flex-direction: column;
    }
  }
</style>
