---
import { Image } from "astro:assets";
import { lunaArtifacts, lunaFolders } from "../../data/luna-archive";
import EvidenceViewer from "../artifacts/EvidenceViewer.astro";

const publicArtifacts = lunaArtifacts.filter((artifact) => artifact.publicSafe);
const folders = lunaFolders
  .map((folder) => ({
    ...folder,
    artifacts: folder.artifactIds
      .map((id) => publicArtifacts.find((artifact) => artifact.id === id))
      .filter(Boolean),
  }))
  .filter((folder) => folder.artifacts.length > 0);
---

<section
  id="archive"
  class="luna-archive container"
  aria-labelledby="archive-title"
>
  <header class="luna-archive__heading">
    <p>Explore LUNA // Project archive</p>
    <h2 id="archive-title">Open the archive</h2>
    <p>
      Only reviewed public evidence appears here. More folders will come online
      as current screenshots and historical records are cleared for publication.
    </p>
  </header>
  <div class="luna-archive__folders">
    {
      folders.map((folder, index) => (
        <details class="archive-folder" open={index === 0}>
          <summary>
            <>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{folder.label}</strong>
              <span>{folder.artifacts.length} record</span>
            </>
          </summary>
          <div class="archive-folder__body">
            <p>{folder.description}</p>
            <div class="archive-folder__records">
              {folder.artifacts.map(
                (artifact) =>
                  artifact && (
                    <article class="archive-record">
                      <button
                        type="button"
                        data-evidence-open={artifact.id}
                        aria-haspopup="dialog"
                      >
                        <span class="archive-record__image">
                          <Image
                            src={artifact.image!}
                            alt={artifact.alt ?? ""}
                            widths={[480, 800, 1200]}
                            sizes="(max-width: 48rem) calc(100vw - 4rem), 34rem"
                            format="webp"
                            quality={80}
                          />
                        </span>
                        <span class="archive-record__copy">
                          <span>
                            {artifact.state} // {artifact.artifactType}
                          </span>
                          <strong>{artifact.title}</strong>
                          <span>{artifact.description}</span>
                          <span>Inspect record ↗</span>
                        </span>
                      </button>
                    </article>
                  ),
              )}
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
<EvidenceViewer artifacts={publicArtifacts} />

<style>
  .luna-archive {
    padding-block: clamp(var(--space-8), 11vw, 9rem);
  }
  .luna-archive__heading {
    max-width: 48rem;
  }
  .luna-archive__heading > p:first-child,
  summary,
  .archive-record__copy > span:first-child,
  .archive-record__copy > span:last-child {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .luna-archive__heading h2 {
    margin-block-start: var(--space-3);
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
  }
  .luna-archive__heading > p:last-child {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
  }
  .luna-archive__folders {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-7);
  }
  .archive-folder {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }
  summary {
    display: grid;
    min-height: 4.5rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary strong {
    color: var(--color-text-primary);
    font-family: var(--font-primary);
    font-size: 1rem;
  }
  summary::after {
    content: "+";
    color: var(--color-accent-highlight);
    font-size: 1.25rem;
  }
  summary > span:last-of-type {
    display: none;
  }
  details[open] summary {
    border-block-end: 1px solid var(--color-border);
    background: rgb(115 71 216 / 7%);
  }
  details[open] summary::after {
    content: "−";
  }
  .archive-folder__body {
    padding: clamp(var(--space-4), 4vw, var(--space-6));
  }
  .archive-folder__body > p {
    color: var(--color-text-muted);
  }
  .archive-folder__records {
    margin-block-start: var(--space-5);
  }
  .archive-record button {
    display: grid;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-canvas);
    color: var(--color-text-primary);
    cursor: pointer;
    text-align: start;
    transition:
      border-color var(--motion-fast),
      transform var(--motion-fast);
  }
  .archive-record button:hover,
  .archive-record button:focus-visible {
    border-color: var(--color-accent-highlight);
    transform: translateY(-0.125rem);
  }
  .archive-record__image img {
    width: 100%;
    height: auto;
  }
  .archive-record__copy {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .archive-record__copy strong {
    font-size: 1.5rem;
  }
  .archive-record__copy > span:nth-child(3) {
    color: var(--color-text-muted);
  }
  @media (min-width: 48rem) {
    summary > span:last-of-type {
      display: block;
    }
    .archive-record button {
      grid-template-columns: minmax(18rem, 1.15fr) minmax(16rem, 0.85fr);
      align-items: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .archive-record button {
      transition: none;
    }
    .archive-record button:hover,
    .archive-record button:focus-visible {
      transform: none;
    }
  }
</style>
