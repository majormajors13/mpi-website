---
import ArtifactCard from "./ArtifactCard.astro";
import EvidenceViewer from "./EvidenceViewer.astro";
import type { EvidenceArtifact } from "../../data/evidence";

// EDITABLE PLACEHOLDERS: replace slot data as real workshop material becomes public.
const artifacts = [
  {
    slot: "01",
    type: "UI Capture",
    title: "Working interface",
    caption: "Reserved for a real product surface.",
    project: "LUNA",
    layout: "wide" as const,
  },
  {
    slot: "02",
    type: "Early Sketch",
    title: "First-pass thinking",
    caption: "A future scan from the notebook or whiteboard.",
    project: "MPI",
    layout: "tall" as const,
  },
  {
    slot: "03",
    type: "System Diagram",
    title: "How the parts connect",
    caption: "Reserved for a public-safe architecture view.",
    project: "LUNA",
  },
  {
    slot: "04",
    type: "Workbench",
    title: "Physical build",
    caption: "A place for hardware, tools, and unfinished pieces.",
    project: "Workshop",
  },
  {
    slot: "05",
    type: "Before / After",
    title: "What changed",
    caption: "A paired view for design and engineering revisions.",
    project: "MPI Website",
    layout: "wide" as const,
  },
  {
    slot: "06",
    type: "Video Demo",
    title: "Full workflow",
    caption: "Reserved for a short, captioned demonstration.",
    project: "LUNA",
  },
];
const evidence: EvidenceArtifact[] = artifacts.map((artifact) => ({
  id: `artifact-${artifact.slot}`,
  slot: artifact.slot,
  title: artifact.title,
  artifactType: artifact.type,
  project: artifact.project,
  description: artifact.caption,
  state: "planned",
  what: artifact.caption,
  problem: "This mount is reserved for verified public evidence.",
  decision: "The slot stays clearly marked until a real artifact is approved.",
  concepts: [artifact.type],
  publicSafe: true,
}));
---

<section
  id="artifacts"
  class="artifact-wall"
  aria-labelledby="artifact-wall-title"
>
  <div class="container">
    <header class="artifact-wall__heading">
      <div>
        <p class="artifact-wall__label">From the workshop // Artifact wall</p>
        <h2 id="artifact-wall-title">What the work looks like</h2>
      </div>
      <p>
        Rough sketches, screenshots, diagrams, and the odd piece of real process
        live here as the workshop fills out. These mounts stay clearly marked
        until verified material is ready.
      </p>
    </header>
    <div class="artifact-wall__grid">
      {
        artifacts.map((artifact) => (
          <ArtifactCard id={`artifact-${artifact.slot}`} {...artifact} />
        ))
      }
    </div>
  </div>
</section>

<EvidenceViewer artifacts={evidence} />

<style>
  .artifact-wall {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--space-8), 11vw, 9rem);
    border-block-end: 1px solid var(--color-border);
  }
  .artifact-wall::before {
    position: absolute;
    inset: 5rem -5rem auto auto;
    width: 25rem;
    height: 18rem;
    border: 1px solid rgb(172 124 255 / 5%);
    background: linear-gradient(
      45deg,
      transparent 49%,
      rgb(172 124 255 / 4%) 49% 49.3%,
      transparent 49.3%
    );
    content: "";
    pointer-events: none;
  }
  .artifact-wall__heading {
    display: grid;
    gap: var(--space-5);
    align-items: end;
  }
  .artifact-wall__label {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .artifact-wall h2 {
    margin-block-start: var(--space-3);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    letter-spacing: -0.055em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .artifact-wall__heading > p {
    max-width: 38rem;
    color: var(--color-text-muted);
  }
  .artifact-wall__grid {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-7);
  }
  @media (min-width: 44rem) {
    .artifact-wall__heading {
      grid-template-columns: 1fr minmax(18rem, 0.7fr);
    }
    .artifact-wall__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 68rem) {
    .artifact-wall__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 32rem) {
    .artifact-wall::before {
      opacity: 0.55;
    }
  }
</style>
