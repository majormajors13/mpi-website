---
import { Image } from "astro:assets";
import secondaryMpiLogo from "../../assets/logos/secondary-mpi-logo.jpeg";
import StatusLabel from "../StatusLabel.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__content">
      <StatusLabel label="System status // Initializing" />
      <p class="hero__eyebrow">Major Problem Industries</p>
      <h1 id="hero-title">Software, AI, and the occasional strange machine.</h1>
      <p class="hero__summary">
        Major Problem Industries is my workshop for useful software, ambitious
        experiments, and the ideas I cannot leave alone.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#identity">What is MPI?</a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__logo-frame">
        <Image
          class="hero__logo"
          src={secondaryMpiLogo}
          alt="Major Problem Industries logo: a violet MPI circuit emblem with Industries lettering"
          widths={[320, 480, 600]}
          sizes="(max-width: 60rem) min(82vw, 30rem), min(42vw, 37.5rem)"
          format="webp"
          quality={85}
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-block-end: 1px solid var(--color-border);
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    inset-block-start: 18%;
    inset-inline-end: -12rem;
    width: 30rem;
    height: 30rem;
    border-radius: 50%;
    background: rgb(115 71 216 / 12%);
    filter: blur(7rem);
    content: "";
    pointer-events: none;
  }

  .hero::after {
    position: absolute;
    z-index: -1;
    inset: 10% -4rem auto auto;
    width: min(42rem, 58vw);
    height: 24rem;
    background:
      radial-gradient(
        circle at 12% 20%,
        rgb(172 124 255 / 9%) 0 2px,
        transparent 3px
      ),
      radial-gradient(
        circle at 56% 64%,
        rgb(172 124 255 / 7%) 0 2px,
        transparent 3px
      ),
      linear-gradient(
        90deg,
        transparent 12%,
        rgb(172 124 255 / 5%) 12% 12.2%,
        transparent 12.2% 56%,
        rgb(172 124 255 / 4%) 56% 56.2%,
        transparent 56.2%
      ),
      linear-gradient(
        135deg,
        transparent 47%,
        rgb(172 124 255 / 4%) 47% 47.3%,
        transparent 47.3%
      );
    background-size:
      18rem 12rem,
      22rem 16rem,
      100% 100%,
      20rem 20rem;
    content: "";
    opacity: 0.8;
    pointer-events: none;
    animation: circuit-arrival 900ms ease-out both;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding-block: clamp(var(--space-7), 9vw, 7rem);
  }

  .hero__content {
    max-width: 42rem;
  }

  .hero__eyebrow {
    margin-block-start: var(--space-5);
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin-block-start: var(--space-3);
    font-size: clamp(2.5rem, 8vw, 5.75rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero__summary {
    max-width: 38rem;
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-medium);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) ease-out,
      border-color var(--motion-fast) ease-out,
      color var(--motion-fast) ease-out,
      box-shadow var(--motion-fast) ease-out;
  }

  .button--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: var(--shadow-accent);
    color: var(--color-text-primary);
  }

  .button--primary:hover {
    border-color: var(--color-accent-highlight);
    background: var(--color-accent-highlight);
    color: var(--color-canvas);
  }

  .hero__visual {
    width: min(100%, 37.5rem);
    margin-inline: auto;
  }

  .hero__logo-frame {
    position: relative;
    padding: clamp(var(--space-2), 2vw, var(--space-4));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface), var(--shadow-accent);
    transition:
      border-color var(--motion-fast) ease-out,
      box-shadow 240ms ease-out;
  }

  .hero__visual:hover .hero__logo-frame,
  .hero__visual:focus-within .hero__logo-frame {
    border-color: rgb(172 124 255 / 45%);
    box-shadow:
      var(--shadow-surface),
      0 0 3.5rem rgb(115 71 216 / 28%);
  }

  .hero__logo-frame::before,
  .hero__logo-frame::after {
    position: absolute;
    width: 3.5rem;
    height: 3.5rem;
    border-color: var(--color-accent-highlight);
    content: "";
    pointer-events: none;
  }

  .hero__logo-frame::before {
    inset-block-start: -1px;
    inset-inline-start: -1px;
    border-block-start: 1px solid;
    border-inline-start: 1px solid;
    border-start-start-radius: var(--radius-large);
  }

  .hero__logo-frame::after {
    inset-block-end: -1px;
    inset-inline-end: -1px;
    border-block-end: 1px solid;
    border-inline-end: 1px solid;
    border-end-end-radius: var(--radius-large);
  }

  .hero__logo {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-large) - var(--space-2));
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    }
  }

  @media (max-width: 32rem) {
    .hero::after {
      width: 18rem;
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
    .hero::after {
      animation: none;
    }
  }

  @keyframes circuit-arrival {
    from {
      opacity: 0;
      transform: translateX(1rem);
    }
    to {
      opacity: 0.8;
      transform: translateX(0);
    }
  }
</style>
