---
// EDITABLE PLACEHOLDERS: replace these entries only with verified current work.
const benchItems = [
  {
    number: "01",
    project: "Current work item",
    status: "Status pending content",
  },
  {
    number: "02",
    project: "Current work item",
    status: "Status pending content",
  },
  {
    number: "03",
    project: "Current work item",
    status: "Status pending content",
  },
];
---

<section id="bench" class="bench container" aria-labelledby="bench-title">
  <div class="bench__plate">
    <div class="bench__heading">
      <p>Live workshop status</p>
      <h2 id="bench-title">On the bench</h2>
      <span>Content slots // Ready</span>
    </div>
    <ol>
      {
        benchItems.map((item) => (
          <li>
            <span class="bench__number">[{item.number}]</span>
            <div>
              <h3>{item.project}</h3>
              <p>{item.status}</p>
            </div>
            <span class="bench__lamp" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .bench {
    padding-block: clamp(var(--space-7), 8vw, 7rem);
  }
  .bench__plate {
    display: grid;
    gap: var(--space-6);
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background:
      linear-gradient(110deg, rgb(115 71 216 / 7%), transparent 32%),
      var(--color-surface);
    box-shadow: inset 0 0 2.5rem rgb(0 0 0 / 30%);
  }
  .bench__heading > p,
  .bench__heading > span,
  .bench__number,
  .bench li p {
    color: var(--color-text-muted);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bench__heading > p,
  .bench__number {
    color: var(--color-accent-highlight);
  }
  h2 {
    margin-block: var(--space-2);
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: -0.05em;
    line-height: 1;
    text-transform: uppercase;
  }
  .bench ol {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bench li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    min-height: 5rem;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-canvas);
  }
  .bench li h3 {
    font-size: 1rem;
    text-transform: uppercase;
  }
  .bench li p {
    margin-block-start: var(--space-1);
  }
  .bench__lamp {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent-secondary);
    box-shadow: 0 0 0.6rem rgb(118 45 66 / 50%);
  }
  @media (min-width: 52rem) {
    .bench__plate {
      grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.35fr);
      align-items: center;
    }
  }
</style>
