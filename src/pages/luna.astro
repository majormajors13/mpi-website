---
import { Image } from "astro:assets";
import lunaLogo from "../assets/logos/luna-logo.png";
import DevelopmentTimeline from "../components/luna/DevelopmentTimeline.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "LUNA is a persistent AI and knowledge project that keeps context across research, planning, decisions, and controlled action.";
---

<BaseLayout title="LUNA" description={description}>
  <main id="main-content" class="luna-page" tabindex="-1">
    <header class="luna-hero" aria-labelledby="luna-title">
      <a class="luna-hero__back" href="/">← Major Problem Industries</a>
      <div class="luna-hero__inner container">
        <div class="luna-hero__copy">
          <p class="technical-label">Project // LUNA</p>
          <p class="luna-hero__name">Luminary Unit of Nuisance Abatement</p>
          <h1 id="luna-title">LUNA</h1>
          <p class="luna-hero__lead">
            An AI system that remembers where you left off.
          </p>
          <p class="luna-hero__description">
            LUNA is a local-first assistant and platform for persistent
            knowledge, research, planning, visible decisions, and governed
            actions. It keeps useful context across sessions while leaving the
            user in control of what happens and what is retained.
          </p>
          <ul class="status-list" aria-label="LUNA project status">
            <li>Active development</li><li>Proprietary / closed source</li><li>
              Independently built
            </li>
          </ul>
        </div>
        <div class="luna-hero__logo-wrap">
          <Image
            class="luna-hero__logo"
            src={lunaLogo}
            alt=""
            widths={[280, 420, 640, 800]}
            sizes="(max-width: 52rem) min(76vw, 22rem), min(34vw, 25rem)"
            format="webp"
            quality={85}
          />
        </div>
      </div>
    </header>

    <DevelopmentTimeline />

    <footer class="luna-footer">
      <div class="container">
        <p class="technical-label">
          MPI is the workshop. LUNA is the machine.
        </p><h2>Back to the workshop.</h2><a href="/"
          >Return to Major Problem Industries</a
        >
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .luna-page {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 12% 32%,
        rgb(188 64 207 / 7%) 0 2px,
        transparent 3px
      ),
      linear-gradient(
        115deg,
        transparent 48%,
        rgb(172 124 255 / 3%) 48% 48.2%,
        transparent 48.2%
      ),
      radial-gradient(
        circle at 80% 5%,
        rgb(115 71 216 / 12%),
        transparent 32rem
      ),
      var(--color-canvas);
    background-size:
      24rem 20rem,
      34rem 34rem,
      auto,
      auto;
  }
  :global(.technical-label),
  .luna-hero__name {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .luna-hero {
    position: relative;
    isolation: isolate;
    min-height: min(58rem, 100vh);
    padding-block: var(--space-5) clamp(var(--space-8), 10vw, 8rem);
    border-block-end: 1px solid var(--color-border);
  }
  .luna-hero::before {
    position: absolute;
    z-index: -1;
    inset: 8% -12rem auto auto;
    width: 38rem;
    height: 38rem;
    border: 1px solid rgb(172 124 255 / 10%);
    border-radius: 50%;
    box-shadow: inset 0 0 6rem rgb(115 71 216 / 7%);
    content: "";
  }
  .luna-hero::after {
    position: absolute;
    z-index: -1;
    inset: auto -3rem 7% auto;
    width: min(44rem, 70vw);
    height: 18rem;
    background:
      radial-gradient(
        circle at 18% 42%,
        rgb(172 124 255 / 10%) 0 2px,
        transparent 3px
      ),
      linear-gradient(
        145deg,
        transparent 49%,
        rgb(172 124 255 / 4%) 49% 49.3%,
        transparent 49.3%
      );
    content: "";
    pointer-events: none;
  }
  .luna-hero__back {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-inline-start: var(--content-gutter);
    color: var(--color-text-muted);
    font-family: var(--font-technical);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .luna-hero__inner {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-7), 8vw, 7rem);
    padding-block-start: clamp(var(--space-7), 8vw, 7rem);
  }
  .luna-hero__copy {
    max-width: 42rem;
  }
  .luna-hero__name {
    margin-block-start: var(--space-4);
  }
  h1 {
    margin-block-start: var(--space-3);
    font-size: clamp(4.5rem, 18vw, 10rem);
    letter-spacing: -0.07em;
    line-height: 0.84;
  }
  .luna-hero__lead {
    max-width: 36rem;
    margin-block-start: var(--space-6);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
  }
  .luna-hero__description {
    max-width: 44rem;
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }
  .status-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .status-list li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
  }
  .luna-hero__logo-wrap {
    width: min(76vw, 25rem);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 1.5rem;
    box-shadow:
      var(--shadow-surface),
      0 0 5rem rgb(115 71 216 / 20%);
  }
  .luna-hero__logo {
    width: 100%;
    height: auto;
  }
  .luna-footer {
    padding-block: clamp(var(--space-8), 11vw, 8rem);
    text-align: center;
  }
  .luna-footer h2 {
    margin-block-start: var(--space-3);
    font-size: clamp(2.25rem, 7vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .luna-footer a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    margin-block-start: var(--space-6);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-accent-highlight);
    border-radius: 999px;
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }
  @media (min-width: 52rem) {
    .luna-hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    }
  }
  @media (max-width: 32rem) {
    .luna-page {
      background-size:
        22rem 20rem,
        42rem 42rem,
        auto,
        auto;
    }
    .luna-hero::after {
      opacity: 0.45;
    }
  }
</style>
