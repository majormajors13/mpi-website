---
import { Image } from "astro:assets";
import type { EvidenceArtifact } from "../../data/evidence";

interface Props {
  artifacts: EvidenceArtifact[];
}
const { artifacts } = Astro.props;
---

<dialog
  class="evidence-viewer"
  data-evidence-dialog
  aria-labelledby="evidence-viewer-title"
>
  <div class="evidence-viewer__bar">
    <p>MPI // Evidence inspection</p>
    <button type="button" data-evidence-close
      >Close <span aria-hidden="true">×</span></button
    >
  </div>
  {
    artifacts.map((artifact) => (
      <article
        class="evidence-viewer__record"
        data-evidence-record={artifact.id}
        hidden
      >
        <div class="evidence-viewer__media">
          {artifact.image ? (
            <Image
              src={artifact.image}
              alt={artifact.alt ?? ""}
              widths={[480, 800, 1200, 1600]}
              sizes="(max-width: 60rem) calc(100vw - 4rem), 54rem"
              format="webp"
              quality={82}
            />
          ) : (
            <div class="evidence-viewer__pending" aria-hidden="true">
              <span>{artifact.artifactType}</span>
              <strong>Archive mount</strong>
            </div>
          )}
        </div>
        <div class="evidence-viewer__heading">
          <p>
            {artifact.project} // {artifact.artifactType}
          </p>
          <h2 id="evidence-viewer-title">{artifact.title}</h2>
          <p>{artifact.description}</p>
        </div>
        <dl class="evidence-viewer__details">
          <div>
            <>
              <dt>What you're looking at</dt>
              <dd>{artifact.what}</dd>
            </>
          </div>
          <div>
            <>
              <dt>Why this exists</dt>
              <dd>{artifact.problem}</dd>
            </>
          </div>
          <div>
            <>
              <dt>Why I built it this way</dt>
              <dd>{artifact.decision}</dd>
            </>
          </div>
          {artifact.result && (
            <div>
              <dt>Result</dt>
              <dd>{artifact.result}</dd>
            </div>
          )}
        </dl>
        <div class="evidence-viewer__concepts">
          <>
            <h3>What this demonstrates</h3>
            <ul>
              {artifact.concepts.map((concept) => (
                <li>{concept}</li>
              ))}
            </ul>
          </>
        </div>
        {artifact.href && (
          <a class="evidence-viewer__link" href={artifact.href}>
            {artifact.hrefLabel ?? "Dig deeper"} →
          </a>
        )}
      </article>
    ))
  }
</dialog>

<style>
  .evidence-viewer {
    width: min(calc(100% - 2rem), 64rem);
    max-height: calc(100vh - 2rem);
    padding: clamp(var(--space-4), 4vw, var(--space-6));
    overflow: auto;
    border: 1px solid var(--color-accent-highlight);
    border-radius: var(--radius-large);
    background: var(--color-canvas);
    color: var(--color-text-primary);
    box-shadow: 0 0 5rem rgb(115 71 216 / 30%);
  }
  .evidence-viewer::backdrop {
    background: rgb(4 3 7 / 86%);
    backdrop-filter: blur(0.25rem);
  }
  .evidence-viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .evidence-viewer__bar button {
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: inherit;
    cursor: pointer;
  }
  .evidence-viewer__record {
    margin-block-start: var(--space-5);
  }
  .evidence-viewer__media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }
  .evidence-viewer__media img {
    width: 100%;
    height: auto;
  }
  .evidence-viewer__pending {
    display: grid;
    min-height: 20rem;
    align-content: space-between;
    padding: var(--space-5);
    background: radial-gradient(
      circle at 70% 30%,
      rgb(115 71 216 / 20%),
      transparent 14rem
    );
    font-family: var(--font-technical);
    text-transform: uppercase;
  }
  .evidence-viewer__heading {
    margin-block-start: var(--space-5);
  }
  .evidence-viewer__heading > p:first-child,
  dt,
  .evidence-viewer__concepts h3 {
    color: var(--color-accent-highlight);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .evidence-viewer__heading h2 {
    margin-block-start: var(--space-2);
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    line-height: 1;
  }
  .evidence-viewer__heading > p:last-child,
  dd {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
  }
  .evidence-viewer__details {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
  }
  .evidence-viewer__details > div {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }
  dd {
    margin-inline: 0;
  }
  .evidence-viewer__concepts {
    margin-block-start: var(--space-6);
  }
  .evidence-viewer__concepts ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .evidence-viewer__concepts li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
  .evidence-viewer__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-block-start: var(--space-6);
    color: var(--color-accent-highlight);
    font-weight: 700;
  }
  @media (min-width: 46rem) {
    .evidence-viewer__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLDialogElement>("[data-evidence-dialog]")
    .forEach((dialog) => {
      const close = dialog.querySelector<HTMLButtonElement>(
        "[data-evidence-close]",
      );
      let returnTarget: HTMLElement | null = null;
      document
        .querySelectorAll<HTMLButtonElement>("[data-evidence-open]")
        .forEach((opener) =>
          opener.addEventListener("click", () => {
            const record = dialog.querySelector<HTMLElement>(
              `[data-evidence-record="${opener.dataset.evidenceOpen}"]`,
            );
            if (!record) return;
            dialog
              .querySelectorAll<HTMLElement>("[data-evidence-record]")
              .forEach((item) => (item.hidden = item !== record));
            returnTarget = opener;
            dialog.showModal();
            close?.focus();
          }),
        );
      close?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => returnTarget?.focus());
      dialog.addEventListener("keydown", (event) => {
        if (event.key !== "Tab") return;
        const focusable = [
          ...dialog.querySelectorAll<HTMLElement>(
            "button, [href], [tabindex]:not([tabindex='-1'])",
          ),
        ].filter((element) => !element.closest("[hidden]"));
        const first = focusable[0];
        const last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      });
    });
</script>
