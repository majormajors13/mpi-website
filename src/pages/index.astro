---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StatusLabel from "../components/StatusLabel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="site-frame">
    <SiteHeader />
    <main id="main-content" class="temporary-content container" tabindex="-1">
      <div class="temporary-content__panel">
        <StatusLabel label="System status // Initializing" />
        <h1>Major Problem Industries</h1>
        <p>Site content will be introduced in a later implementation stage.</p>
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .site-frame {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .temporary-content {
    display: grid;
    flex: 1;
    align-items: center;
    padding-block: var(--space-7);
  }

  .temporary-content__panel {
    position: relative;
    width: min(100%, var(--content-width-reading));
    padding: clamp(var(--space-5), 6vw, var(--space-8));
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: linear-gradient(
      145deg,
      var(--color-surface-raised),
      var(--color-surface)
    );
    box-shadow: var(--shadow-surface), var(--shadow-accent);
  }

  .temporary-content__panel::before {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--space-5);
    width: 5rem;
    height: 1px;
    background: var(--color-accent-highlight);
    box-shadow: var(--shadow-accent);
    content: "";
    pointer-events: none;
  }

  h1 {
    margin-block-start: var(--space-4);
    font-size: clamp(2rem, 8vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  p:not(:first-child) {
    max-width: 36rem;
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }
</style>
